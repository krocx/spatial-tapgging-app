{
  "name": "spatial-tagging-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "sib",
    "ar-client",
    "sib/roadmap-client"
  ],
  "scripts": {
    "dev:sib": "npm run dev --workspace=sib",
    "dev:client": "npm run dev --workspace=ar-client",
    "dev:roadmap": "npm run dev --workspace=sib/roadmap-client",
    "build:roadmap": "npm run build --workspace=sib/roadmap-client",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
