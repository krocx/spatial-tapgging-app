# Line-ending policy — keep text files LF everywhere, including Windows
# checkouts (the internal SIB server). Overrides any local core.autocrlf.
#
# Why: the server serves some of these files verbatim at runtime (e.g.
# docs/roadmap-glossary.md → GET /mindmap/glossary), and CRLF once broke the
# roadmap client's markdown parser. LF-on-disk removes the platform variable.

# Default: auto-detect text, normalize to LF in the repo
* text=auto eol=lf

# Source and content files — explicitly LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env   text eol=lf
Dockerfile     text eol=lf
.dockerignore  text eol=lf
.gitignore     text eol=lf

# Windows batch scripts are the one place CRLF is required
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binaries — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.pdf   binary
*.glb   binary
*.usdz  binary
*.zip   binary
*.xcassets binary
