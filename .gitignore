# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Node / npm (root monorepo, sib/, shared/, ar-client/) ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TypeScript compiled output ────────────────────────────────────────────────
dist/
build/

# ── SIB runtime data (local dev only — persisted via Render Disk in production) ─
.sib-data/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Xcode / iOS ───────────────────────────────────────────────────────────────
ios-app/**/*.xcuserstate
ios-app/**/*.xcuserdata/
ios-app/**/xcuserdata/
ios-app/**/DerivedData/
ios-app/**/*.hmap
ios-app/**/*.ipa
ios-app/**/*.dSYM.zip
ios-app/**/*.dSYM
ios-app/**/archives/
ios-app/**/iphoneos/
ios-app/**/iphonesimulator/

# Xcode local settings (per-developer, not for version control)
ios-app/**/*.pbxuser
ios-app/**/*.mode1v3
ios-app/**/*.mode2v3
ios-app/**/*.perspectivev3
ios-app/**/project.xcworkspace/xcuserdata/
ios-app/**/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Xcode Previews cache
ios-app/**/SourcePackages/
ios-app/**/.swiftpm/

# CocoaPods (if ever adopted)
ios-app/**/Pods/
ios-app/**/Podfile.lock

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tgz
*.zip
