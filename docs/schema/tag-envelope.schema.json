{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sib.appliedx/schema/tag-envelope.schema.json",
  "title": "SIB .tag envelope (tag/1.1)",
  "description": "Signed, deterministic manifest of one tagged part or one chamber (assembly). Spec: docs/TAG-FORMAT.md. No JSON numbers anywhere in the payload; floats are fixed 6-decimal strings.",
  "type": "object",
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["format", "kind", "subject", "issuer", "streams", "subscribe", "contentVersion"],
      "properties": {
        "format": { "enum": ["tag/1.0", "tag/1.1"] },
        "kind": { "enum": ["part", "assembly"] },
        "subject": { "type": "object", "required": ["id", "label"], "properties": {
          "id": { "type": "string" }, "label": { "type": "string" }, "anchorId": { "type": "string" },
          "assetId": { "type": "string" }, "type": { "type": "string" } } },
        "issuer": { "type": "object", "required": ["platform", "version"], "properties": {
          "platform": { "const": "SIB" }, "version": { "type": "string" } } },
        "spatial": { "$ref": "#/$defs/vec3" },
        "frame": { "$ref": "#/$defs/frame" },
        "streams": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "ref", "sha256"], "properties": {
          "name": { "type": "string" }, "ref": { "type": "string" }, "sha256": { "$ref": "#/$defs/hex64" }, "contentVersion": { "type": "string" } } } },
        "members": { "type": "array", "items": { "type": "object", "required": ["tagId", "label", "ref", "sha256"], "properties": {
          "tagId": { "type": "string" }, "label": { "type": "string" }, "ref": { "type": "string" }, "sha256": { "$ref": "#/$defs/hex64" },
          "spatial": { "$ref": "#/$defs/vec3" }, "type": { "type": "string" } } } },
        "subscribe": { "type": "object", "required": ["hints"], "properties": { "hints": { "type": "array", "items": { "type": "string" } } } },
        "contentVersion": { "type": "string" }
      }
    },
    "signature": { "type": "object", "required": ["alg", "publicKey", "sig"], "properties": {
      "alg": { "const": "Ed25519" }, "publicKey": { "type": "string" }, "sig": { "type": "string" } } }
  },
  "$defs": {
    "fixed": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{6}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vec3": { "type": "object", "required": ["x", "y", "z"], "properties": {
      "x": { "$ref": "#/$defs/fixed" }, "y": { "$ref": "#/$defs/fixed" }, "z": { "$ref": "#/$defs/fixed" } } },
    "frame": { "type": "object", "required": ["kind", "markerId"], "properties": {
      "kind": { "const": "qr" }, "markerId": { "type": "string" }, "markerSizeM": { "$ref": "#/$defs/fixed" },
      "anchorPose": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/fixed" } },
      "originSource": { "type": "string" } } }
  }
}
